{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../order_reservation.db"
  },
  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "swagger"
  },
  "Webhook": {
    "Enabled": false,
    "EndpointUrl": "",
    "HmacSecret": "",
    "NotifyOnEstoqueReservado": true,
    "NotifyOnPedidoCancelado": true,
    "TimeoutSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "StructuredFilePath": "logs/api-.ndjson"
  },
  "AllowedHosts": "*"
}
