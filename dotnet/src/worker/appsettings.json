{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../order_reservation.db"
  },
  "SimulatedQueue": {
    "SimulateOutage": false
  },
  "MockInventory": {
    "FailureRate": 0.35
  },
  "OutboxWorker": {
    "MaxRetryAttempts": 5
  },
  "Webhook": {
    "Enabled": false,
    "EndpointUrl": "",
    "HmacSecret": "",
    "NotifyOnEstoqueReservado": true,
    "NotifyOnPedidoAbortado": true,
    "TimeoutSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "StructuredFilePath": "logs/worker-.ndjson"
  }
}
